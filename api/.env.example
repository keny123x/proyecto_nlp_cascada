# Copia este archivo como api/.env y ajusta los valores si hace falta

# Puerto donde escucha el servidor
PUERTO=8000

# Rutas del modelo y las métricas (por defecto: src/models/)
# RUTA_MODELO=src/models/pipeline_modelo.pkl
# RUTA_METRICAS=src/models/metricas.json

# Orígenes permitidos por CORS, separados por coma (* = todos)
ORIGENES_PERMITIDOS=*

# Cantidad máxima de caracteres por reseña
MAX_CARACTERES=2000
